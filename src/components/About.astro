---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="Sobre mim" href="sobre">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
    <p class="w-auto text-base text-neutral md:pr-5 leading-relaxed whitespace-pre-line">
      {description}
    </p>
    <div class="h-80 w-64 shrink-0 rotate-[5deg] bg-white p-4 shadow-md transition-transform hover:rotate-0 md:rotate-[7deg]">
      <img
        class="h-full w-full object-cover rounded-sm"
        src={image}
        alt={name || "Dayse Monteiro"}
        loading="lazy"
      />
    </div>
  </div>
</Section>
