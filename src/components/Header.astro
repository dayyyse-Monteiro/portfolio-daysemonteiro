
---
import Menu from "@icons/Menu.astro";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { siteLogo, navLinks } = Astro.props;
---

<header
  class="sticky top-0 z-50 mx-auto flex max-w-5xl justify-between bg-black px-5 py-6"
>
  <a href="/" aria-label="Ir para o início">
    <img
      class="h-[45px] w-[45px] rounded-full object-cover"
      src={siteLogo}
      alt="Logo Dayse Monteiro"
      loading="eager"
    />
  </a>

  <button
    type="button"
    id="menu-button"
    class="px-1.5 text-neutral sm:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
    aria-label="Abrir menu"
  >
    <Menu />
  </button>

  <nav
    id="main-menu"
    class="absolute right-5 top-20 hidden rounded-xl border border-neutral/40 bg-black px-4 py-5 text-neutral sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
    aria-label="Navegação principal"
  >
    <ul class="flex flex-col gap-2 sm:flex-row">
      {
        navLinks.map((link) => (
          <li class="relative">
            <a
              class="nav-item relative block p-2 text-sm font-medium transition-colors duration-300 hover:text-white"
              href={link.href}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const initializeHeader = () => {
    const button = document.querySelector<HTMLButtonElement>("#menu-button");
    const menu = document.querySelector<HTMLElement>("#main-menu");

    if (!button || !menu || button.dataset.initialized === "true") {
      return;
    }

    button.dataset.initialized = "true";

    const mobileQuery = window.matchMedia("(max-width: 639px)");

    const closeMenu = () => {
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Abrir menu");
    };

    const openMenu = () => {
      menu.classList.remove("hidden");
      button.setAttribute("aria-expanded", "true");
      button.setAttribute("aria-label", "Fechar menu");
    };

    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";

      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");

        if (!href) return;

        if (href.startsWith("#")) {
          const target = document.getElementById(href.slice(1));

          if (target) {
            event.preventDefault();

            target.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });

            history.replaceState(null, "", href);
          }
        }

        if (mobileQuery.matches) {
          closeMenu();
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (
        mobileQuery.matches &&
        !menu.classList.contains("hidden") &&
        !menu.contains(event.target as Node) &&
        !button.contains(event.target as Node)
      ) {
        closeMenu();
      }
    });

    mobileQuery.addEventListener("change", () => {
      if (!mobileQuery.matches) {
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menu");
      } else {
        closeMenu();
      }
    });
  };

  initializeHeader();

  document.addEventListener("astro:page-load", initializeHeader);
</script>
